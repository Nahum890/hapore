{
  "name": "pyfis-ia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PyFis IA: PWA educativa offline para aprender Física de 3.º curso mediante aprendizaje interactivo.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:apk": "vite build --mode capacitor && npx cap sync android",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "start:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-demo.ps1 preview",
    "start:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-demo.ps1 dev",
    "start:mock": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-demo.ps1 mock"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "jspdf": "^4.2.1",
    "motion": "^13.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
