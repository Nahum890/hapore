# Copiá este archivo como .env y completá los valores. Nunca subas .env al repositorio.

# Tutor online (Gemini). Sin esto, PyFis usa el tutor local sin internet.
GEMINI_API_KEY=TU_API_KEY_DE_GEMINI_AQUI
GEMINI_MODEL=gemini-3.8-flash

# Clases, alumnos, resultados y chat compartidos entre teléfonos (ver supabase/README.md).
# Van en el build: en Vercel cargalas también en Settings → Environment Variables.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLIC

# Opcional: solo si el APK empaqueta los archivos (Capacitor) en vez de abrir la URL pública (TWA).
# VITE_API_BASE_URL=https://tu-app.vercel.app
# CORS_ORIGINS=https://localhost,capacitor://localhost
